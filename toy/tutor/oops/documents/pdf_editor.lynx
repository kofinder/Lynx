import "interface/advance_document";

class PdfEditor implements AdvancedDocumentIO {

    public void read() override {
        system.prettyPrint("Reading PDF .......");
    }

    public void write() override {
        system.prettyPrint("Writing to PDF .......");
    }

    public void open() override {
        system.prettyPrint("Opening PDF document .......");
    }

    public void close() override {
        system.prettyPrint("Closing PDF document .......");
    }

    public void save() override {
        system.prettyPrint("Saving PDF .......");
    }

    public void exporter(string word) override {
        system.prettyPrint(word);
    }
    
}