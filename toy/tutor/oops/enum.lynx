


enum Direction {
  LEFT = "L",
  RIGHT = "R",
  UP    = "U", 
  DOWN  = "D"
}

enum Permission {
  READ    = 1 << 0, // 0001
  WRITE   = 1 << 1, // 0010
  EXECUTE = 1 << 2  // 0100
};

enum Color {
  RED ,
  BLUE = 2,
  GREEN = 3,
  YELLOW = 4 + 6,
  ORANGE = 5 * 4,
  CYAN = 6,
  WHITE = 7
}

enum Direction {
  LEFT = 'L',
  RIGHT = "Right",
  UP = 300,
  DOWN
}

enum Syntax {
  UPPERCASE = 'U',
  LOWERCASE = 'C',
  SNAKE_CASE = 'S'
}

int main() { 

  Syntax sytx = Syntax::SNAKE_CASE;

  if (Syntax::UPPERCASE == sytx) {

    system.prettyPrint("UPPERCASE");

  } else if (sytx == Syntax::LOWERCASE) {

    system.prettyPrint("LOWERCASE");

  } else if (sytx == Syntax::SNAKE_CASE) {

    system.prettyPrint("SNAKE_CASE");

  } else {

    system.prettyPrint("No match");

  }

  return 0;

}

