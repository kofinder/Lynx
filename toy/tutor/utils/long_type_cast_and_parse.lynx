

int main() {

    // CASTING
    long ch = 9223372036854775807;
    byte x = ch::toByte();
    short x = ch::toShort();
    int x = ch::toInt();
    long x = ch::toLong();
    float x = ch::toFloat();
    double x = ch::toDouble();
    char x = ch::toChar();
    boolean x = ch::toBool();
    string x = ch::toString();
    system.io.println("Result ====>:", x);

    // PARSING
    byte num = 7;
    short num = 1;
    int num = 2147483647;
    long num = 9223372036854775807;
    float num = 1.0;
    double num = 0.0;
    char num = 'A';
    boolean num = true;
    string num = "0";

    long xl = long.parse(num);
    system.io.println("Result ====>:", xl);
    
    return 64;
}