

int main() {

    // CASTING
    char ch = "A";
    byte x = ch::toByte();
    boolean x = ch::toBool();
    string x = ch::toString();
    short x = ch::toShort();
    int x = ch::toInt();
    long x = ch::toLong();
    float x = ch::toFloat();
    double x = ch::toDouble();
    char x = ch::toChar();
    system.io.println("Result ====>:", x);

    // PARSING
    byte num = 30;
    short num = 1;
    int num = 1;
    long num = 1;
    float num = 1.0;
    double num = 0.0;
    char num = 'A';
    boolean num = true;
    string num = "0";

    char chp = char.parse(num);
    system.io.println("Result ====>:", chp);
    
    return 64;
}