

int main() {

    // CASTING
    short ch = 1;
    byte x = ch::toByte();
    boolean x = ch::toBool();
    string x = ch::toString();
    short x = ch::toShort();
    int x = ch::toInt();
    long x = ch::toLong();
    float x = ch::toFloat();
    double x = ch::toDouble();
    char x = ch::toChar();
    system.io.println("Result ====>:", x);

    // PARSING
    boolean num = true;
    short num = 1;
    byte num = 3;
    int num = 2147483647;
    long num = 9223372036854775807;
    float num = 1.0;
    double num = 0.0;
    char num = 'A';
    string num = "0";

    short xs = char.parse(num);
    system.io.println("Result ====>:", xs);

    return 64;
}