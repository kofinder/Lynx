
int factorial_head_recursion(int n) {

  if(n < 0 || n == 1) {
    return 1; 
  }

  int result = factorial_head_recursion(n - 1);

  return n * result;
}

int factorial_tail_recursion(int n, int accumulator) {

  if(n < 0 || n == 1) {
    return accumulator;
  }

  return factorial_tail_recursion(n -1, accumulator * n);
}

double profit_calculation(double revenue, double cost) {
    return revenue - cost;
}

double profit_margin(double revenue, double cost) {
  if (revenue == 0.0) {
    return 0.0;
  }

  double profit = profit_calculation(revenue, cost);

  double margin = (profit / revenue) * 100.0;

  return margin;
}
