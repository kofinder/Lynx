{
    "name": "lynx",
    "displayName": "Lynx Extension",
    "description": "General purpose language with LSP",
    "version": "1.0.0",
    "publisher": "Jovian",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:lynx"
    ],
    "main": "./app.js",
    "contributes": {
        "languages": [
            {
                "id": "lynx",
                "aliases": [
                    "Lynx",
                    "lynx"
                ],
                "extensions": [
                    ".lynx"
                ]
            }
        ],
        "themes": [
            {
                "label": "Lynx Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/lynx_color_theme.json"
            }
        ],
        "grammars": [
            {
                "language": "lynx",
                "scopeName": "source.lynx",
                "path": "./textmate/lynx_language.json"
            }
        ]
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "scripts": {
        "vscode:prepublish": "echo Skipping prepublish"
    }
}