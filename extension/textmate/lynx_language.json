{
  "scopeName": "source.lynx",
  "name": "LynxLang",
  "patterns": [
    { "_comment": "Comments", "name": "comment.line.double-slash.lynx", "match": "//.*$" },
    { "_comment": "Comments", "name": "comment.block.lynx", "begin": "/\\*", "end": "\\*/" },

    { "_comment": "Strings", "name": "string.quoted.double.lynx", "match": "\"([^\"\\\\]|\\\\.)*\"" },

    { "_comment": "Numbers", "name": "constant.numeric.lynx", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" },

    { "_comment": "Control keywords", "name": "keyword.control.lynx", "match": "\\b(import|return|if|else|for|while|break|case|catch|default|finally)\\b" },
    { "_comment": "Type keywords", "name": "keyword.type.lynx", "match": "\\b(byte|short|int|long|float|double|char|string|boolean|auto|array|set|map|vector|list)\\b" },

    { "_comment": "General declaration keywords", "name": "keyword.declaration.lynx", "match": "\\b(class|enum|interface)\\b" },
    { "_comment": "Inheritance keywords", "name": "keyword.declaration.inheritance.lynx", "match": "\\b(extends|implements)\\b" },

    { "_comment": "Classes / Support", "name": "support.class.lynx", "match": "\\b(system|collections|algorithm|sm)\\b" },
    { "_comment": "Classes / Support", "name": "entity.name.type.class.lynx", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
    { "_comment": "Enums", "name": "constant.other.enum.lynx", "match": "\\b[A-Z][A-Z0-9_]*\\b" },

    { "_comment": "Functions", "name": "entity.name.function.lynx", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*(?=\\()" },

    { "_comment": "Operators", "name": "keyword.operator.assignment.lynx", "match": "=" },
    { "_comment": "Operators", "name": "keyword.operator.arithmetic.lynx", "match": "[+\\-*/%]" },
    { "_comment": "Operators", "name": "keyword.operator.comparison.lynx", "match": "==|!=|<=|>=|<|>" },
    { "_comment": "Operators", "name": "keyword.operator.pipe.lynx", "match": "\\|>" },

    { "_comment": "Punctuation", "name": "punctuation.bracket.lynx", "match": "[\\(\\)\\{\\}\\[\\]]" },
    { "_comment": "Punctuation", "name": "punctuation.separator.lynx", "match": "[,;:.]" },

    { "name": "keyword.declaration.access.public.lynx", "match": "\\bpublic\\b" },
    { "name": "keyword.declaration.access.private.lynx", "match": "\\bprivate\\b" },
    { "name": "keyword.declaration.access.protected.lynx", "match": "\\bprotected\\b" },
    { "name": "keyword.declaration.access.default.lynx", "match": "\\bdefault\\b" },    

    { "_comment": "Variables (catch-all, not keywords)",
      "name": "variable.other.lynx",
      "match": "\\b(?!class|enum|interface|extends|implements|import|return|if|else|for|while|break|case|catch|default|finally|byte|short|int|long|float|double|char|string|boolean|auto|array|set|map|vector|list)\\w+\\b"
    }
  ],
  "repository": {}
}
